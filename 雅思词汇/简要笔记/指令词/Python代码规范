## 二、数据结构规范

### 2.1 使用 dataclass 替代字典
```python
from dataclasses import dataclass, field
from typing import List, Optional
from enum import Enum

# ✅ 正确：结构化配置
@dataclass(frozen=True)  # 不可变配置
class CodecRule:
    """编码选择规则（类似Go struct）"""
    codec: str          # 编码类型
    max_height: int     # 最大高度
    weight: int         # 优先级权重

@dataclass
class PlayStrategy:
    """播放策略配置"""
    priorities: List[CodecRule]
    fallback_to_any: bool = True
    cache_mb: int = 32
    cookies_path: Optional[str] = None
    
    @classmethod
    def default(cls) -> 'PlayStrategy':
        """构造函数模式"""
        return cls(
            priorities=[
                CodecRule("avc1", 1080, 100),
                CodecRule("hev1", 1080, 80),
            ]
        )
    
    def with_timeout(self, seconds: int) -> 'PlayStrategy':
        """链式配置模式"""
        self.cache_mb = seconds
        return self

# ❌ 错误：使用裸字典
strategy = {
    "priorities": [...],
    "cache_mb": 32
}
```

