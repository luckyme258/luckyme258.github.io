## 八、完整示例

```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
B站视频播放器 - 类型强化版
符合Go/Java/Zig风格的Python代码
"""

import os
import signal
import subprocess
import threading
from dataclasses import dataclass
from enum import Enum, auto
from typing import List, Optional, Tuple, Callable, Dict, Any

# ========== 类型别名 ==========
VideoURL = str
VideoTitle = str
ErrorMsg = Optional[str]
ProcessHandle = Optional[subprocess.Popen]

# ========== 枚举定义 ==========
class PlayerStatus(Enum):
    """播放器状态枚举"""
    IDLE = auto()
    LOADING = auto()
    PLAYING = auto()
    PAUSED = auto()
    ERROR = auto()

class HwDecMode(str, Enum):
    """硬件解码模式"""
    AUTO_SAFE = "auto-safe"
    AUTO = "auto"
    DISABLED = "no"

# ========== 数据结构 ==========
@dataclass(frozen=True)
class VideoQuality:
    """视频质量配置"""
    height: int
    bitrate: int
    codec: str

@dataclass
class PlayConfig:
    """播放配置"""
    hardware_decoding: HwDecMode = HwDecMode.AUTO_SAFE
    cache_size_mb: int = 32
    timeout_seconds: int = 30
    cookies_path: Optional[str] = None
    
    @classmethod
    def default(cls) -> 'PlayConfig':
        """默认配置"""
        return cls()
    
    def with_cache(self, size_mb: int) -> 'PlayConfig':
        """链式设置缓存大小"""
        self.cache_size_mb = size_mb
        return self

# ========== 主类 ==========
class VideoPlayer:
    """视频播放器主类"""
    
    # 类常量
    DEFAULT_CACHE: int = 32
    MAX_RETRY: int = 3
    VERSION: str = "1.0.0"
    
    def __init__(self, config: Optional[PlayConfig] = None) -> None:
        """
        初始化播放器
        
        Args:
            config: 播放配置，None时使用默认配置
        """
        # 实例变量声明（必须）
        self.config: PlayConfig = config or PlayConfig.default()
        self.current_process: ProcessHandle = None
        self.status: PlayerStatus = PlayerStatus.IDLE
        self.playlist: List[VideoURL] = []
        self.current_index: int = -1
        
        # 回调函数
        self.on_status_change: Optional[Callable[[PlayerStatus], None]] = None
    
    def play(self, url: VideoURL) -> Tuple[bool, ErrorMsg]:
        """
        播放视频
        
        Args:
            url: 视频URL地址
        
        Returns:
            (是否成功, 错误信息)
        """
        if self.status == PlayerStatus.PLAYING:
            return False, "Already playing"
        
        self.status = PlayerStatus.LOADING
        self._notify_status_change()
        
        # 启动播放
        proc, err = self._start_mpv(url)
        if err:
            self.status = PlayerStatus.ERROR
            self._notify_status_change()
            return False, err
        
        self.current_process = proc
        self.status = PlayerStatus.PLAYING
        self._notify_status_change()
        
        # 启动监控线程
        self._start_monitor_thread()
        
        return True, None
    
    def _start_mpv(self, url: str) -> Tuple[ProcessHandle, ErrorMsg]:
        """
        启动mpv进程
        
        Returns:
            (进程对象, 错误信息)
        """
        cmd: List[str] = [
            "mpv",
            f"--hwdec={self.config.hardware_decoding.value}",
            f"--cache={self.config.cache_size_mb}",
            url
        ]
        
        try:
            proc: subprocess.Popen = subprocess.Popen(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True
            )
            return proc, None
        except FileNotFoundError:
            return None, "mpv not found in PATH"
        except Exception as e:
            return None, str(e)
    
    def _notify_status_change(self) -> None:
        """通知状态变更"""
        if self.on_status_change:
            self.on_status_change(self.status)
    
    def _start_monitor_thread(self) -> None:
        """启动进程监控线程"""
        def monitor() -> None:
            if self.current_process:
                self.current_process.wait()
                self.status = PlayerStatus.IDLE
                self._notify_status_change()
                self.current_process = None
        
        thread: threading.Thread = threading.Thread(target=monitor, daemon=True)
        thread.start()
    
    def stop(self) -> bool:
        """
        停止播放
        
        Returns:
            是否成功停止
        """
        if not self.current_process:
            return False
        
        try:
            pgid: int = os.getpgid(self.current_process.pid)
            os.killpg(pgid, signal.SIGTERM)
            self.current_process = None
            self.status = PlayerStatus.IDLE
            self._notify_status_change()
            return True
        except (ProcessLookupError, PermissionError):
            return False

# ========== 主函数 ==========
def main() -> None:
    """程序入口"""
    # 创建配置
    config: PlayConfig = PlayConfig.default().with_cache(64)
    
    # 创建播放器
    player: VideoPlayer = VideoPlayer(config)
    
    # 设置回调
    def on_status_change(status: PlayerStatus) -> None:
        print(f"状态变更: {status}")
    
    player.on_status_change = on_status_change
    
    # 播放视频
    success, err = player.play("https://example.com/video.mp4")
    if not success:
        print(f"播放失败: {err}")
        return
    
    print("播放中...")
    
    # 等待用户输入
    input("按回车停止...")
    player.stop()

if __name__ == "__main__":
    main()
```

## 九、代码检查清单

在提交代码前，确认以下所有项：

- [ ] 所有实例变量在 `__init__` 中有类型注解
- [ ] 所有函数有完整的参数和返回值类型注解
- [ ] 返回类型包含 `-> None` 若无返回值
- [ ] 复杂配置使用 `@dataclass` 而非字典
- [ ] 字符串常量使用 `Enum` 定义
- [ ] 使用 `Optional[T]` 表示可能为None的值
- [ ] 错误处理使用 `(result, error)` 元组模式
- [ ] 使用类型别名简化复杂类型
- [ ] 有完整的文档字符串
- [ ] 导入语句按规范排序
- [ ] 类常量使用大写命名
- [ ] 私有方法以下划线开头

